{
  "name": "nomix-intelligent-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.6.2",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["packages/*", "examples/playground", "examples/agent"],
  "scripts": {
    "build": "npm run build --workspace @nomix/intelligent-ui-core && npm run build --workspace @nomix/intelligent-ui-react && npm run build --workspace @nomix/intelligent-ui-vue && npm run build --workspace @nomix/intelligent-ui-theme && npm run build --workspace @nomix/intelligent-ui-playground",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:packages": "node scripts/check-packages.mjs",
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:playground\"",
    "dev:api": "tsx watch examples/agent/src/server.ts",
    "dev:playground": "npm run dev --workspace @nomix/intelligent-ui-playground",
    "check": "npm run build && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react": "16.3.1",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "concurrently": "10.0.6",
    "happy-dom": "21.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vue": "3.5.44",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.11"
  }
}
